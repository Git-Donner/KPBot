{
  "inputs": [
    {
      "path": "prepared/baseline.csv",
      "format": "csv",
      "dimensions": {
        "version": "baseline"
      }
    },
    {
      "path": "prepared/candidate.csv",
      "format": "csv",
      "dimensions": {
        "version": "candidate"
      }
    }
  ],
  "mapping": {
    "metrics": [
      {
        "name": "latency",
        "column": "latency_ms",
        "unit": "ms",
        "sample_level": "independent_run"
      }
    ]
  },
  "charts": [
    {
      "id": "latency",
      "type": "bar",
      "metric": "latency",
      "x": "case",
      "series": "version",
      "aggregate": "mean",
      "unit_id": "run_id",
      "title": "Simulated independent experiments",
      "ylim": [
        0,
        100
      ]
    }
  ],
  "output": {
    "formats": [
      "svg",
      "png"
    ],
    "run_name": "v2"
  }
}