{
  "input": {
    "path": "D:\\workspace\\KPBot\\KPBot-zl\\validation\\local-smoke\\samples.csv",
    "format": "csv"
  },
  "mapping": {
    "metrics": [
      {
        "name": "latency_ms",
        "column": "latency_ms",
        "unit": "ms",
        "sample_level": "summary"
      },
      {
        "name": "throughput_mib_s",
        "column": "throughput_mib_s",
        "unit": "MiB/s",
        "sample_level": "summary"
      },
      {
        "name": "min_ms",
        "column": "min_ms",
        "unit": "ms",
        "sample_level": "summary"
      },
      {
        "name": "max_ms",
        "column": "max_ms",
        "unit": "ms",
        "sample_level": "summary"
      },
      {
        "name": "cpu_seconds",
        "column": "cpu_seconds",
        "unit": "s",
        "sample_level": "summary"
      },
      {
        "name": "cpu_pct",
        "column": "cpu_pct",
        "unit": "% of one core",
        "sample_level": "summary"
      },
      {
        "name": "compressed_ratio",
        "column": "compressed_ratio",
        "unit": "output/input",
        "sample_level": "summary"
      }
    ]
  },
  "charts": [
    {
      "id": "scatter",
      "type": "scatter",
      "metric": "latency_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: latency_ms",
      "aggregate": "median",
      "aggregate_summary": true
    },
    {
      "id": "line",
      "type": "line",
      "metric": "throughput_mib_s",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: throughput_mib_s",
      "aggregate": "median",
      "aggregate_summary": true,
      "spread": "minmax",
      "show_samples": true
    },
    {
      "id": "box",
      "type": "box",
      "metric": "latency_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: latency_ms"
    },
    {
      "id": "bar",
      "type": "bar",
      "metric": "cpu_seconds",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: cpu_seconds",
      "aggregate": "median",
      "aggregate_summary": true,
      "spread": "minmax",
      "show_samples": true
    },
    {
      "id": "point",
      "type": "point",
      "metric": "compressed_ratio",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: compressed_ratio",
      "aggregate": "median",
      "aggregate_summary": true,
      "spread": "minmax",
      "show_samples": true
    },
    {
      "id": "heatmap",
      "type": "heatmap",
      "metric": "latency_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: latency_ms",
      "aggregate": "median",
      "aggregate_summary": true
    },
    {
      "id": "hist",
      "type": "hist",
      "metric": "latency_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: latency_ms",
      "filter": {
        "size": "8192"
      }
    },
    {
      "id": "ecdf",
      "type": "ecdf",
      "metric": "latency_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Real zlib measurements: latency_ms",
      "filter": {
        "size": "8192"
      }
    },
    {
      "id": "min_ms",
      "type": "scatter",
      "metric": "min_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Per-run min_ms"
    },
    {
      "id": "max_ms",
      "type": "scatter",
      "metric": "max_ms",
      "x": "size_mib",
      "x_type": "numeric",
      "series": "level",
      "facet": "workload",
      "unit_id": "run_id",
      "title": "Per-run max_ms"
    }
  ],
  "output": {
    "directory": "charts",
    "formats": [
      "svg",
      "png"
    ]
  }
}
